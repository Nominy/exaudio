{
  "id": "exaudio.babel",
  "name": "Babel",
  "version": "0.1.0",
  "api": "^0.1",
  "runtime": "native",
  "description": "Take, edit and submit Babel tasks.",
  "license": "MIT",
  "dependencies": { "exaudio.babel-lint": "^0.1", "exaudio.babel-tags": "^0.1" },
  "permissions": [
    { "kind": "document-read" }, { "kind": "document-edit" },
    { "kind": "audio-read" }, { "kind": "transport-control" },
    { "kind": "selection-control" }, { "kind": "file-picker" },
    { "kind": "storage" }, { "kind": "secrets" },
    { "kind": "network", "scope": "dashboard.babel.audio" },
    { "kind": "network", "scope": "clerk.babel.audio" },
    { "kind": "network", "scope": "reviewgen.ovh" },
    { "kind": "network", "scope": "openrouter.ai" }
  ],
  "providers": [
    { "id": "exaudio.babel.account", "name": "Babel account", "multiple": true }
  ],
  "modes": [
    { "id": "exaudio.babel", "name": "Babel", "provider": "exaudio.babel.account", "requires": { "exaudio.babel-lint": "^0.1", "exaudio.babel-tags": "^0.1" }, "recommends": { "exaudio.gold": "^0.1" } },
    { "id": "exaudio.babel.errors", "name": "Babel error review", "provider": "exaudio.babel.account", "requires": { "exaudio.babel-lint": "^0.1", "exaudio.babel-tags": "^0.1" }, "recommends": { "exaudio.gold": "^0.1" } },
    { "id": "exaudio.babel-file", "name": "Babel file", "launch": "direct", "requires": { "exaudio.babel-lint": "^0.1", "exaudio.babel-tags": "^0.1" }, "recommends": { "exaudio.gold": "^0.1" } }
  ],
  "contributes": {
    "actions": [
      { "id": "exaudio.babel.submit", "title": { "en": "Submit", "ru": "Отправить" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "keys": [{ "key": "ctrl-enter", "when": "focus != 'dialog'" }], "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 0 }] },
      { "id": "exaudio.babel.skip", "title": { "en": "Skip", "ru": "Пропустить" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 1 }] },
      { "id": "exaudio.babel.flag", "title": { "en": "Flag recording", "ru": "Пометить запись" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 2 }] },
      { "id": "exaudio.babel.drop-claim", "title": { "en": "Release task", "ru": "Отпустить задачу" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 3 }] },
      { "id": "exaudio.babel.magic-review", "title": { "en": "Magic Review", "ru": "Magic Review" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 4 }] },
      { "id": "exaudio.babel.feedback", "title": { "en": "Feedback", "ru": "Отзыв" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 5 }] },
      { "id": "exaudio.babel.grader", "title": { "en": "Grade", "ru": "Оценить" }, "category": { "en": "Babel task", "ru": "Задача Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 6 }] },
      { "id": "exaudio.babel.edit-annotation", "title": { "en": "Edit annotation", "ru": "Изменить аннотацию" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 7 }, { "menu": "row/context", "group": "5_babel", "order": 0 }] },
      { "id": "exaudio.babel.open-create-region", "title": { "en": "Add annotation for a range", "ru": "Добавить аннотацию для диапазона" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "palette": false },
      { "id": "exaudio.babel.autofix-row", "title": { "en": "Fix this segment", "ru": "Исправить сегмент" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 8 }] },
      { "id": "exaudio.babel.autofix-all", "title": { "en": "Fix all segments", "ru": "Исправить все сегменты" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 9 }] },
      { "id": "exaudio.babel.skaz-selection", "title": { "en": "Convert to СКАЗ", "ru": "Преобразовать в СКАЗ" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 10 }] },
      { "id": "exaudio.babel.acknowledge-warning", "title": { "en": "Dismiss warning", "ru": "Скрыть предупреждение" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" },
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 11 }] },
      { "id": "exaudio.babel.skaz-digit-0", "title": { "en": "Replace with 0", "ru": "Заменить на 0" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "0", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-1", "title": { "en": "Replace with 1", "ru": "Заменить на 1" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "1", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-2", "title": { "en": "Replace with 2", "ru": "Заменить на 2" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "2", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-3", "title": { "en": "Replace with 3", "ru": "Заменить на 3" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "3", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-4", "title": { "en": "Replace with 4", "ru": "Заменить на 4" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "4", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-5", "title": { "en": "Replace with 5", "ru": "Заменить на 5" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "5", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-6", "title": { "en": "Replace with 6", "ru": "Заменить на 6" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "6", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-7", "title": { "en": "Replace with 7", "ru": "Заменить на 7" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "7", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-8", "title": { "en": "Replace with 8", "ru": "Заменить на 8" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "8", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.skaz-digit-9", "title": { "en": "Replace with 9", "ru": "Заменить на 9" }, "category": { "en": "Babel editing", "ru": "Редактирование Babel" }, "palette": false,
        "when": "editorOpen && (mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file')",
        "keys": [{ "key": "9", "when": "focus == 'transcriptText' && textSelection" }] },
      { "id": "exaudio.babel.relay-start", "title": { "en": "Start sub-account relay", "ru": "Запустить ретранслятор" }, "category": { "en": "Babel account", "ru": "Аккаунт Babel" },
        "when": "mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file'",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 12 }] },
      { "id": "exaudio.babel.relay-stop", "title": { "en": "Stop sub-account relay", "ru": "Остановить ретранслятор" }, "category": { "en": "Babel account", "ru": "Аккаунт Babel" },
        "when": "mode == 'exaudio.babel' || mode == 'exaudio.babel.errors' || mode == 'exaudio.babel-file'",
        "menus": [{ "menu": "editor/overflow", "group": "5_babel", "order": 13 }] }
    ]
  }
}
