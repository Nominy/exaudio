{
  "id": "exaudio.gold",
  "name": "AI tools",
  "version": "0.1.0",
  "api": "^0.1",
  "runtime": "native",
  "description": "Align words, draft text, fill segments and remove noise — on this computer or a remote server.",
  "license": "MIT",
  "permissions": [
    { "kind": "document-read" },
    { "kind": "document-edit" },
    { "kind": "audio-read" },
    { "kind": "transport-control" },
    { "kind": "storage" },
    { "kind": "secrets" },
    { "kind": "network", "scope": "reviewgen.ovh" }
  ],
  "contributes": {
    "actions": [
      { "id": "exaudio.gold.draft", "title": { "en": "Draft with AI…", "ru": "Черновик с ИИ…" }, "category": { "en": "AI tools", "ru": "ИИ-инструменты" },
        "when": "editorOpen",
        "menus": [{ "menu": "editor/toolbar", "group": "5_gold", "order": 0 }, { "menu": "editor/overflow", "group": "5_gold", "order": 0 }] },
      { "id": "exaudio.gold.align", "title": { "en": "Align words", "ru": "Выровнять слова" }, "category": { "en": "AI tools", "ru": "ИИ-инструменты" },
        "when": "editorOpen",
        "menus": [{ "menu": "editor/toolbar", "group": "5_gold", "order": 1 }, { "menu": "editor/overflow", "group": "5_gold", "order": 1 }] },
      { "id": "exaudio.gold.transcribe-segment", "title": { "en": "Fill this segment", "ru": "Заполнить сегмент" }, "category": { "en": "AI tools", "ru": "ИИ-инструменты" },
        "when": "editorOpen",
        "keys": [{ "key": "alt-shift-g" }],
        "menus": [{ "menu": "editor/overflow", "group": "5_gold", "order": 2 }] },
      { "id": "exaudio.gold.settings", "title": { "en": "AI settings…", "ru": "Настройки ИИ…" }, "category": { "en": "AI tools", "ru": "ИИ-инструменты" },
        "menus": [{ "menu": "editor/overflow", "group": "5_gold", "order": 3 }] }
    ]
  }
}
